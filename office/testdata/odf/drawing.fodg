<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.graphics">
  <office:body>
    <office:drawing>
      <draw:page draw:name="Plan">
        <draw:rect svg:x="2cm" svg:y="2cm" svg:width="8cm" svg:height="3cm">
          <text:p>A drawing for docproc</text:p>
        </draw:rect>
        <draw:ellipse svg:x="12cm" svg:y="2cm" svg:width="6cm" svg:height="3cm">
          <text:p>An ellipse</text:p>
        </draw:ellipse>
        <draw:line svg:x1="6cm" svg:y1="5cm" svg:x2="15cm" svg:y2="5cm"/>
        <draw:frame svg:x="2cm" svg:y="7cm" svg:width="16cm" svg:height="2cm">
          <draw:text-box>
            <text:p>Boxes, an ellipse, and a line</text:p>
          </draw:text-box>
        </draw:frame>
      </draw:page>
      <draw:page draw:name="Notes">
        <draw:frame svg:x="2cm" svg:y="2cm" svg:width="16cm" svg:height="2cm">
          <draw:text-box>
            <text:p>The second page of the drawing</text:p>
          </draw:text-box>
        </draw:frame>
      </draw:page>
    </office:drawing>
  </office:body>
</office:document>
